# /etc/duestrack.env — readable by root and the duestrack user only (chmod 640).
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=duestrack.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://duestrack.example.org
POSTGRES_DB=duestrack
POSTGRES_USER=duestrack
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
DUESTRACK_BACKUP_KEY=output-of-manage.py-make_backup_key
DUESTRACK_BACKUP_DIR=/var/backups/duestrack
DUESTRACK_ORG_NAME=the Example Student Organization
DUESTRACK_PRIVACY_CONTACT=the treasurer (treasurer@example.org)
